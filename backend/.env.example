# StudyBuddy AI Backend Configuration
# Add your Gemini API Key here from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_SIZE_MB=25

# Database Configuration (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/studybuddy

# Authentication / JWT Configuration
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
